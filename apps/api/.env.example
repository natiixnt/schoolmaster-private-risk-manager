PORT=3001

# Polaczenie z baza danych - zmien dane dostepu przed uruchomieniem produkcji
DATABASE_URL=postgresql://ZMIEN_UZYTKOWNIKA:ZMIEN_HASLO@localhost:5432/schoolmaster

# JWT - wygeneruj silne, losowe klucze (minimum 32 znaki)
# Przyklad generowania: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=ZMIEN_NA_LOSOWY_STRING_MIN_32_ZNAKI
JWT_REFRESH_SECRET=ZMIEN_NA_INNY_LOSOWY_STRING_MIN_32_ZNAKI

JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# URL frontendu - w produkcji uzyj https://
FRONTEND_URL=http://localhost:3000

# Katalog przechowywania raportow PDF (opcjonalny)
# REPORTS_STORAGE_ROOT=/var/schoolmaster/storage
