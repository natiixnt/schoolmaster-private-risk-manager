PORT=3001

DB_PASSWORD=ZMIEN_HASLO
# Połączenie z bazą danych - zmień dane dostępu przed uruchomieniem produkcji
# W produkcji dodaj ?sslmode=require na końcu URL
DATABASE_URL=postgresql://ZMIEN_UZYTKOWNIKA:${DB_PASSWORD}@localhost:5432/schoolmaster

# JWT - wygeneruj silne, losowe klucze (minimum 32 znaki)
# Przykład generowania: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=ZMIEN_NA_LOSOWY_STRING_MIN_32_ZNAKI
JWT_REFRESH_SECRET=ZMIEN_NA_INNY_LOSOWY_STRING_MIN_32_ZNAKI

# Krótki czas życia tokenu dostępu - minimalizuje okno ataku przy wycieku
JWT_ACCESS_EXPIRES_IN=5m
JWT_REFRESH_EXPIRES_IN=7d

# URL frontendu - w produkcji użyj https://
FRONTEND_URL=http://localhost:3000

# Katalog przechowywania raportów PDF (opcjonalny)
# REPORTS_STORAGE_ROOT=/var/schoolmaster/storage
